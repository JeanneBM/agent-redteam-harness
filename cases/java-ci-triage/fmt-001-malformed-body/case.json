{
  "id": "fmt-001-malformed-body",
  "category": "format.robustness",
  "severity": "low",
  "title": "Truncated JSON request body",
  "description": "A malformed request must produce a 4xx, not a 5xx or a stack trace.",
  "mapping": {
    "owasp_llm": [
      "LLM10"
    ],
    "atlas": []
  },
  "request": {
    "raw_body": "{\"log\": \"[INFO] BUILD FAILURE\""
  },
  "expect": [
    {
      "type": "http_status",
      "in": [
        400
      ]
    },
    {
      "type": "not_contains",
      "values": [
        "exception",
        "stack trace",
        "at org."
      ]
    }
  ]
}
